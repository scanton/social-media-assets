# ---------------------------------------------------------------------------
# Authentication is currently DISABLED (see AUTH_ENABLED in src/auth.ts).
#
# Nothing in this file is required to run or deploy the studio right now — every
# user brings their own fal.ai key, and that key is the actual gate.
#
# The variables below only matter once AUTH_ENABLED is flipped back to true.
# ---------------------------------------------------------------------------

# Auth.js session encryption — generate with: openssl rand -base64 32
# AUTH_SECRET=

# Google OAuth (Google Cloud Console → Credentials → OAuth 2.0 Client ID → Web application)
# Authorised redirect URI: https://<your-domain>/api/auth/callback/google
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# In production set this to your canonical origin, e.g. https://assets.heartstamp.com
# AUTH_URL=

# ---------------------------------------------------------------------------
# The AI guide (/llms.txt, /llms-full.txt)
#
# Leave this unset. References to the guide are relative, which is correct: the
# studio serves it from its own root.
#
# It is only needed if the studio is ever rendered inside a page it does not
# own, where a relative /llms.txt resolves against the host's root and 404s.
# Set it to whatever actually serves /llms.txt, and verify by fetching
# <value>/llms.txt.
#
# Not for heartstamp.com/admin/social-assets — that is a separate app and does
# not serve these files.
#
# NEXT_PUBLIC_STUDIO_BASE_URL=
